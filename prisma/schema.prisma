generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  requested
  booked
  canceled
}

model User {
  id                   String       @id @default(cuid())
  email                String       @unique
  password             String
  name                 String
  title                String
  subTitle             String?
  avatarUrl            String?
  about                String?
  cvUrl                String?
  linkedinUrl          String?
  githubUrl            String?
  forgeCalApiKey       String?
  forgeCalEventSlug    String?
  forgeCalWebhookSecret String?
  forgeCalBaseUrl      String?
  educations           Education[]
  experiences          Experience[]
  projects             Project[]
  skills               Skill[]
  meetings             Meeting[]
  meetingBlocks        MeetingBlock[]
}

model Experience {
  id          String @id @default(cuid())
  userId      String
  title       String
  company     String
  dateString  String
  description String
  user        User   @relation(fields: [userId], references: [id])
}

model Education {
  id           String  @id @default(cuid())
  userId       String
  institution  String
  degree       String
  dateString   String
  marksheetUrl String?
  description  String?
  user         User    @relation(fields: [userId], references: [id])
}

model Skill {
  id         String  @id @default(cuid())
  userId     String
  name       String
  category   String
  level      Int?
  imageUrl   String?
  link       String?
  tags       String
  issuer     String?
  dateString String?
  user       User    @relation(fields: [userId], references: [id])
}

model Project {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String
  imageUrl    String?
  link        String?
  tags        String
  user        User    @relation(fields: [userId], references: [id])
}

model Meeting {
  id               String        @id @default(cuid())
  userId           String
  forgeCalBookingId String       @unique
  guestName        String?
  guestEmail       String?
  startTime        DateTime?
  timezone         String?
  guestMessage     String?
  meetingUrl       String?
  status           MeetingStatus @default(requested)
  sourcePayload    Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime])
  @@index([status, startTime])
}

model MeetingBlock {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime
  endTime   DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startTime, endTime])
}
